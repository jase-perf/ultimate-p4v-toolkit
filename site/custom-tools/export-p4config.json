{
  "name": "Export .p4config",
  "description": "Writes a .p4config file with this workspace's server, user and workspace name to the workspace root, so the p4 command line and other tools use the right connection inside that folder. Never overwrites an existing file.",
  "where": "P4V, from the Tools menu (uses the current workspace)",
  "options": [
    "Run tool in terminal window"
  ],
  "windows": {
    "application": "powershell.exe",
    "arguments": "-NoProfile -Command Invoke-Command -ScriptBlock ([scriptblock]::Create([Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('')))) # $p $c $u $r",
    "source": "cli-tools/export-p4config/export-p4config.ps1"
  },
  "macos": {
    "application": "/bin/zsh",
    "arguments": "-o shwordsplit -lc :;IFS=^;echo$${IFS}|base64$${IFS}--decode|zsh$${IFS}-s$${IFS}--$${IFS}$$@ export-p4config $p $c $u $r",
    "source": "cli-tools/export-p4config/export-p4config.sh"
  }
}
