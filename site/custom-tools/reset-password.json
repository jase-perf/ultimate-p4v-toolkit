{
  "name": "Reset User Password",
  "description": "Sets a random temporary password for the selected user, requires them to choose a new one at next login, and copies a ready-to-send message to your clipboard. Super users only. Needs the p4 command line client on PATH.",
  "where": "P4Admin (or P4V), on a user",
  "options": [
    "Add to applicable context menus",
    "Run tool in terminal window"
  ],
  "windows": {
    "application": "powershell.exe",
    "arguments": "-NoProfile -Command Invoke-Command -ScriptBlock ([scriptblock]::Create([Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('')))) -ArgumentList %u",
    "source": "cli-tools/reset-password/reset-password.ps1"
  },
  "macos": {
    "application": "/bin/zsh",
    "arguments": "-o shwordsplit -lc :;echo$${IFS}|base64$${IFS}--decode|zsh$${IFS}-s$${IFS}--$${IFS}$$1 reset-password %u",
    "source": "cli-tools/reset-password/reset-password.sh"
  }
}
