<?xml version="1.0" encoding="UTF-8"?>
<!--perforce-xml-version=1-->
<CustomToolDefList varName="customtooldeflist">
  <CustomToolDef>
    <Definition>
      <Name>Export .p4config</Name>
      <Command>powershell.exe</Command>
      <Arguments>-NoProfile -Command Invoke-Command -ScriptBlock ([scriptblock]::Create([Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('')))) # $p $c $u $r</Arguments>
      <Shortcut></Shortcut>
    </Definition>
    <Console>
      <CloseOnExit>false</CloseOnExit>
    </Console>
  </CustomToolDef>
</CustomToolDefList>
