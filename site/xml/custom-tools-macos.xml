<?xml version="1.0" encoding="UTF-8"?>
<!--perforce-xml-version=1-->
<CustomToolDefList varName="customtooldeflist">
  <CustomToolDef>
    <Definition>
      <Name>Reset User Password</Name>
      <Command>/bin/zsh</Command>
      <Arguments>-o shwordsplit -lc :;echo$${IFS}|base64$${IFS}--decode|zsh$${IFS}-s$${IFS}--$${IFS}$$1 reset-password %u</Arguments>
      <Shortcut></Shortcut>
    </Definition>
    <Console>
      <CloseOnExit>false</CloseOnExit>
    </Console>
    <AddToContext>true</AddToContext>
  </CustomToolDef>
</CustomToolDefList>
