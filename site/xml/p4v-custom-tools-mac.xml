<?xml version="1.0" encoding="UTF-8"?>
<!--perforce-xml-version=1-->
<CustomToolDefList varName="customtooldeflist">
  <CustomToolDef>
    <Definition>
      <Name>Export .p4config</Name>
      <Command>/bin/zsh</Command>
      <Arguments>-o shwordsplit -lc :;IFS=^;echo$${IFS}|base64$${IFS}--decode|zsh$${IFS}-s$${IFS}--$${IFS}$$@ export-p4config $p $c $u $r</Arguments>
      <Shortcut></Shortcut>
    </Definition>
    <Console>
      <CloseOnExit>false</CloseOnExit>
    </Console>
  </CustomToolDef>
</CustomToolDefList>
